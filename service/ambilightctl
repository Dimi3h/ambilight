#!/bin/sh
# ambilightctl - control the ambilight service on the TV (also used by the settings app
# through Homebrew Channel's exec).
#   start              clear the disable and pause flags and the boot-loop counter, start now
#                      (setup does the same but keeps a pause)
#   stop               write the disable flag (persists across reboots), stop the service
#   restart            stop, then start
#   pause | resume     LEDs off/on while the service keeps running (persists; the blue
#   toggle             remote key does the same when colorkeys=on)
#   status             human-readable state, disable reason, recent log lines
#   json-status        the same as one JSON object (for the settings app)
#   set key=value ...  change settings and apply them without a restart; keys:
#                      host, port (1-65535), priority (1-253), gain (0.1-2.0; shown as
#                      brightness 5-100 %: brightness = gain x 50),
#                      letterbox (on|off), uiblend (on|off), colorkeys (on|off: on the
#                      remote blue toggles ambilight, green dims, yellow brightens; the old
#                      name bluekey is still accepted), subfilter (on|off: keep subtitles
#                      off the LEDs), autoupdate (on|off: install new versions unasked, see
#                      auto-update). Prints {"ok":...}.
#   setup              first run after an install from Homebrew Channel: elevate the
#                      service, add the boot hook, start
#   elevate            (re)grant the service its permissions through Homebrew Channel
#   check-update       read the release feed now; prints the update info as JSON
#   auto-update boot|idle   install the update that maintain downloaded, if autoupdate is
#                      on and the moment is safe: "boot" (the supervisor, before it starts
#                      the service) unless a streaming app is already in the foreground,
#                      "idle" (the service, after a minute on the home screen) only on the
#                      home screen. Exit status 0 = a new version was installed.
#   maintain           periodic upkeep (run by the service): daily update check, and the
#                      download of a new version when autoupdate is on
#   osd                install or update the on-screen level app from the copy in this package
PATH=/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH} # the boot hook's environment has none (see supervise.sh)
export PATH
SVC_DIR=/media/developer/apps/usr/palm/services/io.github.dimi3h.ambilight.service
SVC=io.github.dimi3h.ambilight.service
APP=io.github.dimi3h.ambilight
OSD=io.github.dimi3h.ambilight.osd
OSD_INFO=/media/developer/apps/usr/palm/applications/$OSD/appinfo.json
STATE=/media/developer/ambilight
HOOK=/var/lib/webosbrew/init.d/70-ambilight
HB_ELEVATE=/media/developer/apps/usr/palm/services/org.webosbrew.hbchannel.service/elevate-service
FEED_URL=https://github.com/Dimi3h/ambilight/releases/latest/download/repo.json
# Colour keys of LG's remotes (the TV's own keymap, /etc/webos-profile/common/profile_keymap.json;
# blue also measured with evdev). The TV ignores short presses of them in normal use.
BLUE_KEY=401
GREEN_KEY=399
YELLOW_KEY=400
mkdir -p "$STATE"

running() { pidof ambilight > /dev/null 2>&1; }
log() { echo "$(date '+%F %T') ctl: $*" >> "$STATE/supervise.log"; }
signal_service() {
    pid=$(cat "$STATE/service.pid" 2> /dev/null)
    if [ -n "$pid" ] && running; then kill -USR1 "$pid" 2> /dev/null; fi
}
toast() {
    luna-send -n 1 -a "$APP" luna://com.webos.notification/createToast \
        "{\"sourceId\":\"$APP\",\"message\":\"$1\"}" > /dev/null 2>&1 &
}

stop() {
    echo "$(date '+%F %T') stopped by ambilightctl" > "$STATE/disable"
    sync
    pid=$(cat "$STATE/service.pid" 2> /dev/null)
    [ -n "$pid" ] && kill "$pid" 2> /dev/null # SIGTERM: the service clears its HyperHDR priority
    i=0
    while running && [ $i -lt 30 ]; do sleep 0.2; i=$((i + 1)); done
    # by pid, not by path pattern: "$SVC_DIR/ambilight" would also match this script
    if running; then kill -9 $(pidof ambilight) 2> /dev/null; fi
    pkill -f "$SVC_DIR/supervise.sh" 2> /dev/null
    echo "stopped"
}

# Clear the guards and make sure the supervisor runs. A pause is kept.
launch() {
    rm -f "$STATE/disable"
    echo 0 > "$STATE/boot-attempts"
    sync
    signal_service # a running service re-reads its settings and pause state
    setsid "$SVC_DIR/supervise.sh" now < /dev/null > /dev/null 2>&1 & # exits at once if one runs
    sleep 1
}

start() {
    rm -f "$STATE/paused"
    launch
}

pause() { echo "$(date '+%F %T') paused by ambilightctl" > "$STATE/paused"; sync; signal_service; echo paused; }
resume() { rm -f "$STATE/paused"; sync; signal_service; echo resumed; }

elevate() {
    [ -x "$HB_ELEVATE" ] || { echo "Homebrew Channel's elevate-service not found" >&2; return 1; }
    "$HB_ELEVATE" "$SVC" >> "$STATE/supervise.log" 2>&1
}

# The on-screen level of the brightness keys is a small package of its own (the TV's app
# manager registers one app per package). It is installed from the copy next to this script
# whenever its version differs from ours; the service uses toasts as long as it is missing.
osd_ensure() {
    [ -f "$SVC_DIR/osd.ipk" ] || return 0
    want=$(cat "$SVC_DIR/VERSION" 2> /dev/null)
    have=$(sed -n 's/.*"version":"\([0-9.]*\)".*/\1/p' "$OSD_INFO" 2> /dev/null | head -n 1)
    [ -n "$want" ] && [ "$want" = "$have" ] && return 0
    # the installer wants the package outside the tree it installs into
    mkdir -p /media/developer/tmp && cp "$SVC_DIR/osd.ipk" /media/developer/tmp/ambilight-osd.ipk || return 1
    luna-send -n 1 -w 20000 luna://com.webos.appInstallService/dev/install \
        "{\"id\":\"$OSD\",\"ipkUrl\":\"/media/developer/tmp/ambilight-osd.ipk\",\"subscribe\":false}" > /dev/null 2>&1
    i=0
    until [ "$(sed -n 's/.*"version":"\([0-9.]*\)".*/\1/p' "$OSD_INFO" 2> /dev/null | head -n 1)" = "$want" ] || [ $i -ge 20 ]; do
        sleep 1; i=$((i + 1))
    done
    rm -f /media/developer/tmp/ambilight-osd.ipk
    if [ $i -ge 20 ]; then log "on-screen level: install of $want failed (was: ${have:-none})"; return 1; fi
    log "on-screen level: installed $want (was: ${have:-none})"
}

setup() {
    elevate || echo "warning: elevation failed (see $STATE/supervise.log)"
    osd_ensure || echo "warning: the on-screen level could not be installed (see $STATE/supervise.log)"
    mkdir -p /var/lib/webosbrew/init.d && ln -sfn "$SVC_DIR/autostart.sh" "$HOOK"
    log "setup: boot hook added"
    launch # an upgrade keeps a pause; a first install has none
}

status() {
    if running; then echo "service:    running (pid $(pidof ambilight))"; else echo "service:    not running"; fi
    if pgrep -f "$SVC_DIR/supervise.sh" > /dev/null 2>&1; then echo "supervisor: running"; else echo "supervisor: not running"; fi
    if [ -L "$HOOK" ]; then echo "autostart:  hook installed"; else echo "autostart:  no hook"; fi
    if [ -e "$STATE/disable" ]; then echo "disabled:   $(tail -n 1 "$STATE/disable")"; else echo "disabled:   no"; fi
    if [ -e "$STATE/paused" ]; then echo "paused:     yes ($(cat "$STATE/paused"))"; else echo "paused:     no"; fi
    echo "version:    $(cat "$SVC_DIR/VERSION" 2> /dev/null || echo unknown)"
    echo "boot count: $(cat "$STATE/boot-attempts" 2> /dev/null || echo 0) (3 = boot-loop guard trips)"
    if [ -f "$STATE/ambilight.log" ]; then
        echo "--- last log lines"
        tail -n 5 "$STATE/ambilight.log"
    fi
}

# --- settings: read $STATE/args into variables (defaults first)
read_settings() {
    host=192.168.129.249 port=19444 priority=150 gain=1.0 letterbox=on uiblend=on colorkeys=off
    subfilter=on autoupdate=off
    # shellcheck disable=SC2046 # word splitting of the args file is intended
    set -- $(cat "$STATE/args" 2> /dev/null)
    while [ $# -gt 0 ]; do
        case "$1" in
            --host) host=$2; shift ;;
            --port) port=$2; shift ;;
            --priority) priority=$2; shift ;;
            --gain) gain=$2; shift ;;
            --no-letterbox) letterbox=off ;;
            --no-ui-blend) uiblend=off ;;
            --keep-subtitles) subfilter=off ;;
            --auto-update) autoupdate=on ;;
            --toggle-key) colorkeys=on; shift ;;
            --dim-key | --bright-key) shift ;;
        esac
        shift
    done
}

write_settings() {
    line="--host $host --port $port --priority $priority --gain $gain"
    [ "$letterbox" = off ] && line="$line --no-letterbox"
    [ "$uiblend" = off ] && line="$line --no-ui-blend"
    [ "$subfilter" = off ] && line="$line --keep-subtitles"
    [ "$autoupdate" = on ] && line="$line --auto-update"
    [ "$colorkeys" = on ] && line="$line --toggle-key $BLUE_KEY --dim-key $GREEN_KEY --bright-key $YELLOW_KEY"
    echo "$line" > "$STATE/args.tmp" && mv "$STATE/args.tmp" "$STATE/args"
    sync
}

fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 1; }

set_settings() {
    read_settings
    for kv in "$@"; do
        k=${kv%%=*}
        v=${kv#*=}
        case "$k" in
            host)
                case "$v" in '' | *[!A-Za-z0-9.-]*) fail "invalid host" ;; esac
                [ ${#v} -le 63 ] || fail "invalid host"
                host=$v ;;
            port)
                case "$v" in '' | *[!0-9]*) fail "invalid port" ;; esac
                [ "$v" -ge 1 ] && [ "$v" -le 65535 ] || fail "invalid port"
                port=$v ;;
            priority)
                case "$v" in '' | *[!0-9]*) fail "invalid priority" ;; esac
                [ "$v" -ge 1 ] && [ "$v" -le 253 ] || fail "invalid priority"
                priority=$v ;;
            gain)
                case "$v" in '' | *[!0-9.]* | *.*.*) fail "invalid gain" ;; esac
                awk -v g="$v" 'BEGIN { exit !(g >= 0.1 && g <= 2.0) }' || fail "invalid gain"
                gain=$v ;;
            letterbox | uiblend | subfilter | autoupdate)
                case "$v" in on | off) ;; *) fail "invalid $k" ;; esac
                eval "$k=\$v" ;;
            colorkeys | bluekey)
                case "$v" in on | off) colorkeys=$v ;; *) fail "invalid $k" ;; esac ;;
            *) fail "unknown key" ;;
        esac
    done
    write_settings
    signal_service
    # switched on while a new version is already known: fetch it now, not at the next upkeep
    [ "$autoupdate" = on ] && (fetch_update > /dev/null 2>&1 &)
    echo '{"ok":true}'
}

# --- updates: read the release feed (the same repo.json Homebrew Channel uses)
check_update() {
    cur=$(cat "$SVC_DIR/VERSION" 2> /dev/null || echo 0.0.0)
    if ! curl -fsSL --max-time 30 -o "$STATE/feed.json" "$FEED_URL" 2> "$STATE/update.err"; then
        printf '{"ok":false,"error":"feed not reachable"}\n'
        return 1
    fi
    out=$(node "$SVC_DIR/helper.js" feed "$STATE/feed.json" "$cur")
    case "$out" in *'"latest"'*) ;; *) echo "$out"; return 1 ;; esac
    echo "$out" > "$STATE/update.json.tmp" && mv "$STATE/update.json.tmp" "$STATE/update.json"
    latest=$(echo "$out" | sed -n 's/.*"latest":"\([0-9.]*\)".*/\1/p')
    case "$out" in
        *'"newer":true'*)
            read_settings
            if [ "$(cat "$STATE/update-notified" 2> /dev/null)" != "$latest" ]; then
                echo "$latest" > "$STATE/update-notified"
                log "update $latest available (installed $cur)"
                # with automatic updates the message comes when it has been installed
                [ "$autoupdate" = on ] || toast "Ambilight $latest is beschikbaar. Open de Ambilight-app om bij te werken."
            fi
            [ "$autoupdate" = on ] && fetch_update > /dev/null 2>&1 ;;
    esac
    echo "$out"
}

# true if version $1 is newer than $2
newer() {
    awk -v a="$1" -v b="$2" 'BEGIN { split(a, x, "."); split(b, y, ".")
        for (i = 1; i <= 3; i++) { if (x[i] + 0 > y[i] + 0) exit 0; if (x[i] + 0 < y[i] + 0) exit 1 }
        exit 1 }'
}

# What update.json says about the newest release: sets u_latest, u_url, u_sum (empty if
# there is nothing newer or the file does not look right).
update_info() {
    u_latest= u_url= u_sum=
    u=$(cat "$STATE/update.json" 2> /dev/null)
    case "$u" in *'"newer":true'*) ;; *) return 1 ;; esac
    u_latest=$(echo "$u" | sed -n 's|.*"latest":"\([0-9.]*\)".*|\1|p')
    u_url=$(echo "$u" | sed -n 's|.*"ipkUrl":"\([A-Za-z0-9_.:/-]*\)".*|\1|p')
    u_sum=$(echo "$u" | sed -n 's|.*"sha256":"\([0-9a-f]*\)".*|\1|p')
    case "$u_url" in https://github.com/Dimi3h/ambilight/releases/download/*) ;; *) u_latest=; return 1 ;; esac
    [ -n "$u_latest" ] && [ ${#u_sum} -eq 64 ] || { u_latest=; return 1; }
}

# Automatic updates, step 1 (any time): download the new version and check it against the
# feed's SHA-256. Leaves $STATE/update.ipk and $STATE/update-ready (its version).
fetch_update() {
    update_info || return 1
    cur=$(cat "$SVC_DIR/VERSION" 2> /dev/null || echo 0.0.0)
    newer "$u_latest" "$cur" || return 1
    [ "$(cat "$STATE/update-ready" 2> /dev/null)" = "$u_latest" ] && [ -f "$STATE/update.ipk" ] && return 0
    rm -f "$STATE/update-ready" "$STATE/update.ipk"
    if ! curl -fsSL --max-time 120 -o "$STATE/update.ipk.tmp" "$u_url" 2> "$STATE/update.err"; then
        rm -f "$STATE/update.ipk.tmp"
        log "update $u_latest: download failed"
        return 1
    fi
    if [ "$(sha256sum "$STATE/update.ipk.tmp" | cut -d' ' -f1)" != "$u_sum" ]; then
        rm -f "$STATE/update.ipk.tmp"
        log "update $u_latest: checksum does not match the feed, discarded"
        return 1
    fi
    mv "$STATE/update.ipk.tmp" "$STATE/update.ipk" && echo "$u_latest" > "$STATE/update-ready"
    sync
    log "update $u_latest downloaded and checked; it installs when the TV starts or the home screen is idle"
}

# The app in the foreground ("" = none); "?" if the TV does not answer, so that no answer is
# never taken for no app.
foreground_app() {
    i=0
    while [ $i -lt 3 ]; do
        # stdin from /dev/null: luna-send prints nothing when its stdin is a pipe that was closed
        r=$(luna-send -n 1 -w 5000 luna://com.webos.applicationManager/getForegroundAppInfo '{}' < /dev/null 2> /dev/null)
        case "$r" in *'"appId"'*) echo "$r" | sed -n 's/.*"appId":"\([^"]*\)".*/\1/p'; return 0 ;; esac
        sleep 1; i=$((i + 1))
    done
    echo "?"
}

# Automatic updates, step 2: install what fetch_update left, at a moment when the restart of
# the service cannot cost anyone their light (a service that starts while protected video
# plays gets no colours until that video stops). $1 = boot: called by the supervisor before
# it starts the service; anything but a streaming app may be in the foreground. $1 = idle:
# called by the running service after a minute on the home screen; only there.
# At most three attempts per version. Returns 0 only when the new version is installed.
auto_update() {
    read_settings
    [ "$autoupdate" = on ] || return 1
    ready=$(cat "$STATE/update-ready" 2> /dev/null)
    [ -n "$ready" ] && [ -f "$STATE/update.ipk" ] || return 1
    cur=$(cat "$SVC_DIR/VERSION" 2> /dev/null || echo 0.0.0)
    if ! newer "$ready" "$cur"; then # installed some other way meanwhile
        rm -f "$STATE/update-ready" "$STATE/update.ipk" "$STATE/update-tried"
        return 1
    fi
    # still what the feed names, and still the file that was checked
    if ! update_info || [ "$u_latest" != "$ready" ] || [ "$(sha256sum "$STATE/update.ipk" | cut -d' ' -f1)" != "$u_sum" ]; then
        rm -f "$STATE/update-ready" "$STATE/update.ipk"
        log "update $ready: no longer matches the feed, discarded"
        return 1
    fi
    tried=0
    # shellcheck disable=SC2046
    set -- "$1" $(cat "$STATE/update-tried" 2> /dev/null)
    [ "$2" = "$ready" ] && case "$3" in [0-9]) tried=$3 ;; esac
    [ "$tried" -ge 3 ] && return 1
    fg=$(foreground_app)
    case "$1:$fg" in
        idle:com.webos.app.home) ;;
        boot: | boot:com.webos.app.home | boot:com.webos.app.livetv | boot:com.webos.app.hdmi* | boot:com.webos.app.screensaver) ;;
        *) return 1 ;; # someone is watching something: another time
    esac
    echo "$ready $((tried + 1))" > "$STATE/update-tried"
    log "installing update $ready (installed $cur, $1, attempt $((tried + 1)))"
    luna-send -n 1 -w 30000 luna://com.webos.appInstallService/dev/install \
        "{\"id\":\"$APP\",\"ipkUrl\":\"$STATE/update.ipk\",\"subscribe\":false}" > /dev/null 2>&1
    i=0
    until [ "$(cat "$SVC_DIR/VERSION" 2> /dev/null)" = "$ready" ] || [ $i -ge 40 ]; do sleep 1; i=$((i + 1)); done
    if [ $i -ge 40 ]; then
        log "update $ready: not installed after 40 s"
        return 1
    fi
    rm -f "$STATE/update-ready" "$STATE/update.ipk" "$STATE/update-tried"
    log "update $ready installed"
    toast "Ambilight is bijgewerkt naar versie $ready."
    return 0
}

# Settings written by an older version: the colour-key setting used to be the blue key
# only. Run by the supervisor before it starts the service.
migrate() {
    if grep -q -- '--toggle-key' "$STATE/args" 2> /dev/null && ! grep -q -- '--dim-key' "$STATE/args"; then
        read_settings
        write_settings
        log "settings migrated: colour keys now include green (dim) and yellow (brighten)"
    fi
    osd_ensure # after an update of the package: bring the on-screen level along
    # a downloaded update that is installed by now leaves nothing behind
    rdy=$(cat "$STATE/update-ready" 2> /dev/null)
    if [ -n "$rdy" ] && ! newer "$rdy" "$(cat "$SVC_DIR/VERSION" 2> /dev/null || echo 0.0.0)"; then
        rm -f "$STATE/update-ready" "$STATE/update.ipk" "$STATE/update-tried"
    fi
    # 100 % brightness is gain 2.0 since 0.2.5; a larger stored gain becomes that maximum
    if [ -f "$STATE/args" ]; then
        read_settings
        if awk -v g="$gain" 'BEGIN { exit !(g > 2.0) }'; then
            gain=2.0
            write_settings
            log "settings migrated: gain limited to 2.0 (shown as 100 % brightness)"
        fi
    fi
    return 0
}

maintain() {
    last=$(date -r "$STATE/update.json" +%s 2> /dev/null || echo 0)
    if [ $(($(date +%s) - last)) -ge 72000 ]; then check_update > /dev/null 2>&1; fi
    read_settings
    [ "$autoupdate" = on ] && fetch_update > /dev/null 2>&1 # e.g. the download failed yesterday
    return 0
}

# JSON string from stdin: escape backslash and quote, drop control characters
jstr() { tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
jbool() { if "$@" > /dev/null 2>&1; then echo true; else echo false; fi; }

json_status() {
    read_settings
    r=$(jbool running)
    sv=$(jbool pgrep -f "$SVC_DIR/supervise.sh")
    hook=$(jbool test -L "$HOOK")
    paused=$(jbool test -e "$STATE/paused")
    if [ -e "$STATE/disable" ]; then dis="\"$(tail -n 1 "$STATE/disable" | jstr)\""; else dis=null; fi
    bc=$(cat "$STATE/boot-attempts" 2> /dev/null)
    case "$bc" in '' | *[!0-9]*) bc=0 ;; esac
    ver=$(cat "$SVC_DIR/VERSION" 2> /dev/null | tr -cd '0-9.')
    st=null
    if [ "$r" = true ]; then
        # the service writes status.json only while someone asks: say so, then give it a
        # moment (one loop: 50 ms, 500 ms while paused) to write a fresh one
        : > "$STATE/status.json.want"
        i=0
        while [ $i -lt 10 ]; do
            t=$(sed -n 's/.*"t":\([0-9]*\).*/\1/p' "$STATE/status.json" 2> /dev/null)
            [ -n "$t" ] && [ $(($(date +%s) - t)) -le 3 ] && break
            sleep 0.1
            i=$((i + 1))
        done
        # no fresh status after a second: the service hangs or is still starting
        [ $i -lt 10 ] && st=$(cat "$STATE/status.json")
    fi
    upd=null
    [ -f "$STATE/update.json" ] && upd=$(cat "$STATE/update.json")
    rdy=$(cat "$STATE/update-ready" 2> /dev/null | tr -cd '0-9.')
    if [ -n "$rdy" ] && [ -f "$STATE/update.ipk" ]; then rdy="\"$rdy\""; else rdy=null; fi
    logl=""
    if [ -f "$STATE/ambilight.log" ]; then
        logl=$(tail -n 4 "$STATE/ambilight.log" | while IFS= read -r l; do printf '"%s",' "$(printf '%s' "$l" | jstr)"; done)
    fi
    printf '{"running":%s,"supervisor":%s,"autostart":%s,"paused":%s,"disabled":%s,"boot_count":%s,"version":"%s",' \
        "$r" "$sv" "$hook" "$paused" "$dis" "$bc" "$ver"
    printf '"settings":{"host":"%s","port":%s,"priority":%s,"gain":%s,"letterbox":%s,"ui_blend":%s,"colorkeys":%s,"bluekey":%s,' \
        "$host" "$port" "$priority" "$gain" "$([ "$letterbox" = on ] && echo true || echo false)" \
        "$([ "$uiblend" = on ] && echo true || echo false)" "$([ "$colorkeys" = on ] && echo true || echo false)" \
        "$([ "$colorkeys" = on ] && echo true || echo false)"
    printf '"subfilter":%s,"autoupdate":%s},' "$([ "$subfilter" = on ] && echo true || echo false)" \
        "$([ "$autoupdate" = on ] && echo true || echo false)"
    printf '"update":%s,"update_ready":%s,"status":%s,"log":[%s]}\n' "$upd" "$rdy" "$st" "${logl%,}"
}

case "$1" in
    start) start && status ;;
    stop) stop ;;
    restart) stop && start && status ;;
    pause) pause ;;
    resume) resume ;;
    toggle) if [ -e "$STATE/paused" ]; then resume; else pause; fi ;;
    status | "") status ;;
    json-status) json_status ;;
    set) shift; set_settings "$@" ;;
    setup) setup && status ;;
    elevate) elevate && echo elevated ;;
    check-update) check_update ;;
    auto-update) auto_update "$2"; exit $? ;; # the install replaces this file: nothing may follow
    maintain) maintain ;;
    osd) osd_ensure ;;
    migrate) migrate ;;
    *) echo "usage: $0 start|stop|restart|pause|resume|toggle|status|json-status|set key=value...|setup|elevate|check-update|auto-update boot|idle|maintain|osd" >&2; exit 2 ;;
esac
